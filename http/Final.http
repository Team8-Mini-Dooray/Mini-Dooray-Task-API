@host = http://localhost:8080
@adminId = user1
@memberId = user2

# ============================================================
# Minidooray Task-Api Final Flow Test
# ============================================================
#
# 실행 전제
# 1. DB를 비운 뒤 서버를 실행합니다.
# 2. 위에서부터 순서대로 요청을 실행합니다.
# 3. 응답으로 받은 ID를 아래 변수에 직접 복사해서 다음 요청을 실행합니다.
# 4. Gateway가 붙기 전이므로 모든 요청에 X-User-Id를 직접 넣습니다.
#
# ID 복사 위치
# - 프로젝트 생성 응답의 projectId -> @projectId
# - 태그 생성 응답의 tagId -> @tagId1, @tagId2
# - 마일스톤 생성 응답의 milestoneId -> @milestoneId
# - Task 생성 응답의 taskId -> @taskId
# - 댓글 생성 응답의 commentId -> @commentId
# - 새 마일스톤/태그 동시 생성 Task 응답의 taskId -> @taskWithNewMetaId
#
# 정상 흐름 요약
# Project 생성
# -> 멤버 추가/조회
# -> Tag 2개 생성
# -> Milestone 생성
# -> Task 생성
# -> Task 상세 조회
# -> Task 태그 전체 교체
# -> Task 마일스톤 제거/재설정
# -> Comment 생성/조회/수정/삭제
# -> Task 생성 시 새 Milestone/Tag 동시 생성 확인
# -> Project 상세 조회
# -> 삭제/종료 흐름 확인

@projectId = 7
@tagId1 = 7
@tagId2 = 8
@milestoneId = 9
@taskId = 16
@commentId = 2
@taskWithNewMetaId = 17

### 01. 프로젝트 생성
# 기대: 201 Created
# 응답의 projectId를 @projectId에 복사합니다.
POST {{host}}/projects
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "name": "Final Flow Project"
}

### 02. 내가 속한 프로젝트 목록 조회
# 기대: 200 OK, 방금 만든 프로젝트가 배열에 포함됩니다.
GET {{host}}/projects
X-User-Id: {{adminId}}

### 03. 프로젝트 멤버 목록 조회
# 기대: 200 OK, 프로젝트 생성자인 user1이 멤버로 포함됩니다.
GET {{host}}/projects/{{projectId}}/members
X-User-Id: {{adminId}}

### 04. 프로젝트 멤버 추가
# 기대: 201 Created
# 주의: Task-Api는 Account DB를 직접 검증하지 않으므로 user2 문자열만 저장합니다.
POST {{host}}/projects/{{projectId}}/members
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "userId": "{{memberId}}"
}

### 05. 프로젝트 멤버 목록 재조회
# 기대: 200 OK, user1과 user2가 포함됩니다.
GET {{host}}/projects/{{projectId}}/members
X-User-Id: {{adminId}}

### 06. 태그 생성 - Backend
# 기대: 201 Created
# 응답의 tagId를 @tagId1에 복사합니다.
POST {{host}}/projects/{{projectId}}/tags
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "name": "MONNJAEMIN"
}

### 07. 태그 생성 - Urgent
# 기대: 201 Created
# 응답의 tagId를 @tagId2에 복사합니다.
POST {{host}}/projects/{{projectId}}/tags
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "name": "Urgent"
}

### 08. 태그 목록 조회
# 기대: 200 OK, Backend와 Urgent가 조회됩니다.
GET {{host}}/projects/{{projectId}}/tags
X-User-Id: {{adminId}}

### 09. 마일스톤 생성
# 기대: 201 Created
# 응답의 milestoneId를 @milestoneId에 복사합니다.
POST {{host}}/projects/{{projectId}}/milestones
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "name": "Sprint 1",
  "startDate": "2026-05-15",
  "endDate": "2026-05-22"
}

### 10. 마일스톤 목록 조회
# 기대: 200 OK, Sprint 1이 조회됩니다.
GET {{host}}/projects/{{projectId}}/milestones
X-User-Id: {{adminId}}

### 11. Task 생성 - 기존 마일스톤/태그 연결
# 기대: 201 Created
# 응답의 taskId를 @taskId에 복사합니다.
# writerId는 body의 ignored가 아니라 X-User-Id(adminId)로 저장되어야 정상입니다.
POST {{host}}/projects/{{projectId}}/tasks?milestoneId={{milestoneId}}&tagIds={{tagId1}}&tagIds={{tagId2}}
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "projectId": {{projectId}},
  "title": "Final Flow Task",
  "content": "기존 마일스톤과 태그를 연결해서 생성한 Task입니다.",
  "writerId": "ignored"
}

### 12. Task 상세 조회
# 기대: 200 OK
# milestone 객체, tags 배열, comments 배열이 포함됩니다.
GET {{host}}/projects/{{projectId}}/tasks/{{taskId}}
X-User-Id: {{adminId}}

### 13. Task 목록 조회
# 기대: 200 OK, 프로젝트의 전체 Task 목록이 조회됩니다.
GET {{host}}/projects/{{projectId}}/tasks
X-User-Id: {{adminId}}

### 13-1. Task 목록 조회 - tagId 필터
# 기대: 200 OK, Backend 태그가 연결된 Task만 조회됩니다.
GET {{host}}/projects/{{projectId}}/tasks?tagId={{tagId1}}
X-User-Id: {{adminId}}

### 14. Task 수정
# 기대: 200 OK
# title/content가 수정됩니다.
PUT {{host}}/projects/{{projectId}}/tasks/{{taskId}}/edit
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "title": "Final Flow Task Updated",
  "content": "수정된 Task 내용입니다."
}

### 15. Task 태그 전체 교체
# 기대: 200 OK
# 전체 교체 방식입니다. 같은 tagIds를 다시 보내도 200 OK가 정상입니다.
PUT {{host}}/projects/{{projectId}}/tasks/{{taskId}}/tags
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "tagIds": [{{tagId1}}, {{tagId2}}]
}

### 16. Task 태그 전체 교체 실패 케이스 - 빈 태그
# 기대: 400 Bad Request, TASK_TAG_REQUIRED
PUT {{host}}/projects/{{projectId}}/tasks/{{taskId}}/tags
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "tagIds": []
}

### 17. Task 마일스톤 제거
# 기대: 200 OK, 응답의 milestoneId가 null입니다.
POST {{host}}/projects/{{projectId}}/tasks/{{taskId}}/milestones
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "milestoneId": null
}

### 18. Task 마일스톤 재설정
# 기대: 200 OK, 응답의 milestoneId가 @milestoneId입니다.
POST {{host}}/projects/{{projectId}}/tasks/{{taskId}}/milestones
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "milestoneId": {{milestoneId}}
}

### 19. 댓글 목록 조회
# 기대: 200 OK, 아직 댓글을 만들지 않았다면 [] 입니다.
GET {{host}}/projects/{{projectId}}/tasks/{{taskId}}/comments
X-User-Id: {{adminId}}

### 20. 댓글 생성
# 기대: 201 Created
# 응답의 commentId를 @commentId에 복사합니다.
POST {{host}}/projects/{{projectId}}/tasks/{{taskId}}/comments
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "content": "Final Flow 댓글입니다."
}

### 21. 댓글 목록 재조회
# 기대: 200 OK, 방금 생성한 댓글이 포함됩니다.
GET {{host}}/projects/{{projectId}}/tasks/{{taskId}}/comments
X-User-Id: {{adminId}}

### 22. 댓글 수정
# 기대: 200 OK, content가 수정됩니다.
PUT {{host}}/projects/{{projectId}}/tasks/{{taskId}}/comments/{{commentId}}/edit
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "content": "수정된 Final Flow 댓글입니다."
}

### 23. 댓글 삭제
# 기대: 204 No Content
POST {{host}}/projects/{{projectId}}/tasks/{{taskId}}/comments/{{commentId}}/delete
X-User-Id: {{adminId}}

### 24. Task 생성 - 새 마일스톤/태그를 동시에 생성하고 연결
# 기대: 201 Created
# 새 milestone "Sprint 2"와 새 tag "Frontend"가 생성되고 Task에 연결됩니다.
# 응답의 taskId를 @taskWithNewMetaId에 복사합니다.
POST {{host}}/projects/{{projectId}}/tasks?newMilestoneName=Sprint%202&newMilestoneStartDate=2026-05-23&newMilestoneEndDate=2026-05-29&newTagName=Frontend
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "projectId": {{projectId}},
  "title": "New Metadata Task",
  "content": "Task 생성 시 새 마일스톤과 새 태그를 함께 생성합니다.",
  "writerId": "ignored"
}

### 24. 새 마일스톤/태그 생성 결과 확인 - Task 상세
# 기대: 200 OK, milestone.name이 Sprint 2이고 tags에 Frontend가 포함됩니다.
GET {{host}}/projects/{{projectId}}/tasks/{{taskWithNewMetaId}}
X-User-Id: {{adminId}}

### 25. 마일스톤 목록 재조회
# 기대: 200 OK, Sprint 1과 Sprint 2가 모두 조회됩니다.
GET {{host}}/projects/{{projectId}}/milestones
X-User-Id: {{adminId}}

### 26. 태그 목록 재조회
# 기대: 200 OK, Backend, Urgent, Frontend가 조회됩니다.
GET {{host}}/projects/{{projectId}}/tags
X-User-Id: {{adminId}}

### 27. 프로젝트 상세 조회
# 기대: 200 OK
# members, tasks, milestones가 함께 조회됩니다.
GET {{host}}/projects/{{projectId}}
X-User-Id: {{adminId}}

### 28. 멤버 권한 확인 - user2가 Task 상세 조회
# 기대: 200 OK
GET {{host}}/projects/{{projectId}}/tasks/{{taskId}}
X-User-Id: {{memberId}}

### 29. 댓글 작성자 권한 실패 확인 - user2가 user1 댓글 수정 시도
# 사용하려면 20번 댓글 생성을 다시 실행하고 @commentId를 새 값으로 바꾼 뒤 실행합니다.
# 기대: 403 Forbidden, NOT_COMMENT_WRITER
PUT {{host}}/projects/{{projectId}}/tasks/{{taskId}}/comments/{{commentId}}/edit
Content-Type: application/json
X-User-Id: {{memberId}}

{
  "content": "다른 작성자의 댓글 수정 시도"
}

### 30. Task 삭제
# 기대: 204 No Content
# comments, task_tags는 DB cascade로 함께 삭제되어야 합니다.
POST {{host}}/projects/{{projectId}}/tasks/{{taskId}}/delete
X-User-Id: {{adminId}}

### 31. 새 마일스톤/태그 Task 삭제
# 기대: 204 No Content
POST {{host}}/projects/{{projectId}}/tasks/{{taskWithNewMetaId}}/delete
X-User-Id: {{adminId}}

### 32. 프로젝트 종료
# 기대: 200 OK, status가 TERMINATED 또는 CLOSED 정책에 맞게 종료 상태가 됩니다.
POST {{host}}/projects/{{projectId}}/close
X-User-Id: {{adminId}}

### 33. 종료 프로젝트 쓰기 실패 확인
# 기대: 409 Conflict, PROJECT_NOT_ACTIVE
POST {{host}}/projects/{{projectId}}/tasks
Content-Type: application/json
X-User-Id: {{adminId}}

{
  "projectId": {{projectId}},
  "title": "종료 프로젝트 쓰기 실패 확인",
  "content": "종료 상태에서는 생성되면 안 됩니다.",
  "writerId": "ignored"
}
