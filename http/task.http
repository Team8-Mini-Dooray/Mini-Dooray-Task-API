@host = http://localhost:8080
@projectId = 8
@taskId = 19
@commentId = 1
@milestoneId = 1
@tagId1 = 10
@tagId2 = 10
@userId = user1

### Task 목록 조회 - 프로젝트 전체
# 기대 응답: 200 OK, 해당 프로젝트의 Task 목록(List<TaskDto>)
GET {{host}}/projects/{{projectId}}/tasks
X-User-Id: {{userId}}

### Task 목록 조회 - tagId 필터
# 기대 응답: 200 OK, tagId1 태그가 연결된 Task만 반환
GET {{host}}/projects/{{projectId}}/tasks?tagId={{tagId1}}
X-User-Id: {{userId}}

### Task 상세 조회
GET {{host}}/projects/{{projectId}}/tasks/{{taskId}}
X-User-Id: {{userId}}

### Task 생성 - 기본 정보만 생성
POST {{host}}/projects/{{projectId}}/tasks
Content-Type: application/json
X-User-Id: {{userId}}

{
  "projectId": {{projectId}},
  "title": "Task API 테스트",
  "content": "task.http로 생성한 Task입니다.",
  "writerId": "ignored"
}

### Task 생성 - 기존 마일스톤/태그 연결
POST {{host}}/projects/{{projectId}}/tasks?milestoneId={{milestoneId}}&tagIds={{tagId1}}&tagIds={{tagId2}}
Content-Type: application/json
X-User-Id: {{userId}}

{
  "projectId": {{projectId}},
  "title": "마일스톤 태그 연결 Task",
  "content": "기존 milestoneId와 tagIds를 연결합니다.",
  "writerId": "ignored"
}

### Task 생성 - 새 마일스톤/태그 파라미터 TODO 확인용
 # 새 마일스톤/태그를 생성한 뒤 Task에 연결합니다.
 # 같은 프로젝트에 동일한 마일스톤/태그 이름이 있으면 409가 발생합니다.
POST {{host}}/projects/{{projectId}}/tasks?newMilestoneName=Sprint%2088&newMilestoneStartDate=2026-05-15&newMilestoneEndDate=2026-05-20&newTagName=99
Content-Type: application/json
X-User-Id: {{userId}}

  {
    "projectId": {{projectId}},
    "title": "새 마일스톤 태그 생성 Task",
    "content": "새 마일스톤과 새 태그를 생성하고 Task에 연결합니다.",
    "writerId": "ignored"
  }


### Task 수정
PUT {{host}}/projects/{{projectId}}/tasks/{{taskId}}/edit
Content-Type: application/json
X-User-Id: {{userId}}

{
  "title": "수정된 Task 제목",
  "content": "수정된 Task 내용입니다."
}

### Task 마일스톤 설정
POST {{host}}/projects/{{projectId}}/tasks/{{taskId}}/milestones
Content-Type: application/json
X-User-Id: {{userId}}

{
  "milestoneId": {{milestoneId}}
}

### Task 마일스톤 제거
POST {{host}}/projects/{{projectId}}/tasks/{{taskId}}/milestones
Content-Type: application/json
X-User-Id: {{userId}}

{
  "milestoneId": null
}

### Task 태그 전체 교체
PUT {{host}}/projects/{{projectId}}/tasks/{{taskId}}/tags
Content-Type: application/json
X-User-Id: {{userId}}

{
  "tagIds": [{{tagId1}}, {{tagId2}}]
}

### Task 태그 전체 교체 - 실패 케이스: 태그 0개
PUT {{host}}/projects/{{projectId}}/tasks/{{taskId}}/tags
Content-Type: application/json
X-User-Id: {{userId}}

{
  "tagIds": []
}

### 댓글 목록 조회
GET {{host}}/projects/{{projectId}}/tasks/{{taskId}}/comments
X-User-Id: {{userId}}

### 댓글 생성
POST {{host}}/projects/{{projectId}}/tasks/{{taskId}}/comments
Content-Type: application/json
X-User-Id: {{userId}}

{
  "content": "task.http로 생성한 댓글입니다."
}

### 댓글 수정
PUT {{host}}/projects/{{projectId}}/tasks/{{taskId}}/comments/{{commentId}}/edit
Content-Type: application/json
X-User-Id: {{userId}}

{
  "content": "수정된 댓글 내용입니다."
}

### 댓글 삭제
POST {{host}}/projects/{{projectId}}/tasks/{{taskId}}/comments/{{commentId}}/delete
X-User-Id: {{userId}}

### Task 삭제
POST {{host}}/projects/{{projectId}}/tasks/{{taskId}}/delete
X-User-Id: {{userId}}
